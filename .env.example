# Copy this file to .env and fill in your actual keys.
# Nothing in this file should ever be committed to git.

# TMDB — free, instant signup at themoviedb.org → Settings → API
TMDB_API_KEY=

# YouTube Data API v3 — free, console.cloud.google.com → Enable "YouTube Data API v3" → Create API Key
YOUTUBE_API_KEY=

# No key needed for: Billboard/PopVortex, Steam, Apple RSS (Music/Games/Apps), Podcast charts, Reddit.
# These use public endpoints or fall back automatically if blocked.
